# Salin ke .env lalu isi. Jangan commit file .env.

# Database
DB_TYPE=postgres          # postgres | mysql
DB_HOST=localhost
DB_PORT=                  # kosong = 5432 (postgres) / 3306 (mysql)
DB_USER=
DB_PASSWORD=
DB_NAME=

# Output
BACKUP_DIR=./backups
LOG_FILE=./backup.log

# Notifikasi Telegram (kosongkan untuk mematikan)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
